# Copia este archivo como «.env» (en la raíz del proyecto) y pon tu API key de Claude.
# .env nunca se sube a GitHub: está en .gitignore.
# En Mac puedes usar en su lugar «Configurar API key.command» (la guarda en el Llavero) y no
# necesitas este archivo. Ojo si la carpeta del proyecto se sincroniza con iCloud/Dropbox:
# un .env se sincronizaría en texto plano.
ANTHROPIC_API_KEY=

# Opcional: bot de Slack (ver README). En Mac mejor «Configurar Slack.command».
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USUARIO=
